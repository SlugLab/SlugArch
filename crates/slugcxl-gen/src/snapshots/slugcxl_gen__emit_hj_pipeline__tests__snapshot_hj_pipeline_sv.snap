    || (current_instruction[127:64] != 64'd0);
  wire [127:0] active_range_word =
      active_bank
      ? range_words_bank1[instruction_range_index[1:0]]
      : range_words_bank0[instruction_range_index[1:0]];

  always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      active_bank              <= 1'b0;
      active_instruction_count <= 32'd0;
      active_range_count       <= 32'd0;
      active_metadata_budget   <= 32'd0;
      policy_ready             <= 1'b0;
      policy_error             <= 32'd0;
      policy_digest            <= 256'd0;
      load_in_progress         <= 1'b0;
      load_failed              <= 1'b0;
      load_bank                <= 1'b1;
      load_seen                <= 40'd0;
      load_word_count          <= 7'd0;
      load_magic               <= 32'd0;
      load_abi_version         <= 32'd0;
      load_event_version       <= 32'd0;
      load_packet_version      <= 32'd0;
      load_instruction_count   <= 32'd0;
      load_range_count         <= 32'd0;
      load_metadata_budget     <= 32'd0;
      load_image_bytes         <= 32'd0;
      load_digest_header       <= 256'd0;
      hj_state                 <= HJ_STATE_IDLE;
      program_counter          <= 32'd0;
      execution_steps          <= 6'd0;
      current_instruction      <= 128'd0;
      match_result             <= 1'b0;
      branch_target            <= 32'd0;
      event_id                 <= 64'd0;
      event_direction          <= 1'b0;
      event_class              <= 4'd0;
      event_opcode             <= 4'd0;
      event_address            <= 64'd0;
      event_tag                <= 16'd0;
      event_phase_id           <= 64'd0;
      event_status             <= 32'd0;
      event_payload_len        <= 6'd0;
      event_payload            <= 256'd0;
      event_epoch              <= 64'd0;
      capture_mode             <= HJ_CAPTURE_VALIDATION;
      capture_ready            <= 1'b0;
      captured_bytes           <= 6'd0;
      delta_pair_count         <= 6'd0;
      delta_scan_index         <= 6'd0;
      capture_data             <= 256'd0;
      emit_requested           <= 1'b0;
      pending_record_data      <= 1024'd0;
      pending_record_length    <= 16'd0;
      pending_instruction_steps <= 64'd0;
      record_valid             <= 1'b0;
      record_length            <= 16'd0;
      record_data              <= 1024'd0;
      event_count              <= 64'd0;
      record_count             <= 64'd0;
      metadata_bytes           <= 64'd0;
      reject_count             <= 64'd0;
      instruction_count        <= 64'd0;
      epoch                    <= 64'd0;
      app_flit_bytes           <= 64'd0;
      stall_cycles             <= 64'd0;
      metadata_drop_count      <= 64'd0;
      last_reject_code         <= 16'd0;
      sequence_id              <= 64'd0;
