                    || instruction_arg0 != 8'd0
                    || instruction_skip != 8'd0
                    || instruction_arg1 != 32'd0) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else if (emit_requested && !capture_ready) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else if (emit_requested) begin
                  pending_record_data <= make_record(
                      sequence_id + 64'd1,
                      event_id,
                      policy_digest,
                      event_epoch,
                      event_direction,
                      event_class,
                      event_opcode,
                      event_address,
                      {{48'd0, event_tag}},
                      event_status,
                      capture_mode,
                      event_payload_len,
                      captured_bytes,
                      delta_pair_count,
                      capture_data
                  );
                  pending_record_length <= 16'd96 + {10'd0, captured_bytes};
                  pending_instruction_steps <= {58'd0, execution_steps} + 64'd1;
                  hj_state <= HJ_STATE_EMIT_WAIT;
                end else begin
                  event_count <= event_count + 64'd1;
                  instruction_count <= instruction_count
                      + {58'd0, execution_steps} + 64'd1;
                  epoch <= event_epoch;
                  hj_state <= HJ_STATE_DONE;
                end
              end

              HJ_OP_MATCH_CLASS: begin
                if (instruction_reserved
                    || instruction_arg1 != 32'd0
                    || instruction_skip == 8'd0
                    || !supported_event_class(instruction_arg0[3:0])
                    || instruction_arg0[7:4] != 4'd0) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  match_result <= (event_class == instruction_arg0[3:0]);
                  branch_target <= program_counter + 32'd1
                      + {24'd0, instruction_skip};
                  hj_state <= HJ_STATE_MATCH;
                end
              end

              HJ_OP_MATCH_DIRECTION: begin
                if (instruction_reserved
                    || instruction_arg1 != 32'd0
                    || instruction_skip == 8'd0
                    || instruction_arg0 > 8'd1) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  match_result <=
                      (event_direction == instruction_arg0[0]);
                  branch_target <= program_counter + 32'd1
                      + {24'd0, instruction_skip};
                  hj_state <= HJ_STATE_MATCH;
                end
              end

              HJ_OP_MATCH_STATUS: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip == 8'd0) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  match_result <= (event_status == instruction_arg1);
                  branch_target <= program_counter + 32'd1
                      + {24'd0, instruction_skip};
                  hj_state <= HJ_STATE_MATCH;
                end
              end

              HJ_OP_MATCH_RANGE: begin
                if (instruction_reserved
                    || instruction_arg1 != 32'd0
                    || instruction_skip == 8'd0
                    || {24'd0, instruction_range_index}
                       >= active_range_count) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else if (active_range_word[127:64] == 64'd0
                             || (active_range_word[63:0]
                                 + active_range_word[127:64])
                                < active_range_word[63:0]) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_RANGE;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  match_result <=
                      (event_address >= active_range_word[63:0])
                    && ((event_address - active_range_word[63:0])
                        < active_range_word[127:64]);
                  branch_target <= program_counter + 32'd1
                      + {24'd0, instruction_skip};
                  hj_state <= HJ_STATE_MATCH;
                end
              end

              HJ_OP_SAMPLE: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip == 8'd0
                    || instruction_stride == 32'd0) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_STRIDE;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  match_result <=
                      ((event_id % {32'd0, instruction_stride}) == 64'd0);
                  branch_target <= program_counter + 32'd1
                      + {24'd0, instruction_skip};
                  hj_state <= HJ_STATE_MATCH;
                end
              end

              HJ_OP_CAPTURE: begin
                if (instruction_reserved
                    || instruction_skip != 8'd0
                    || instruction_arg1 != 32'd0
                    || instruction_arg0 > 8'd2) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  capture_mode <= instruction_arg0[1:0];
                  capture_ready <= 1'b0;
                  captured_bytes <= 6'd0;
                  delta_pair_count <= 6'd0;
                  delta_scan_index <= 6'd0;
                  capture_data <= 256'd0;
                  hj_state <= HJ_STATE_CAPTURE;
                end
              end

              HJ_OP_EMIT: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip != 8'd0
                    || instruction_arg1 != 32'd0
                    || emit_requested
                    || (program_counter + 32'd1
                        >= active_instruction_count)) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  emit_requested <= 1'b1;
                  program_counter <= program_counter + 32'd1;
                  hj_state <= HJ_STATE_FETCH;
                end
              end

              HJ_OP_EPOCH_INCREMENT: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip != 8'd0
                    || instruction_arg1 != 32'd0) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else if (event_epoch == 64'hffffffffffffffff) begin
                  policy_error <= SLUG_JIT_ERR_BACKEND;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else if (program_counter + 32'd1
                             >= active_instruction_count) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  event_epoch <= event_epoch + 64'd1;
                  program_counter <= program_counter + 32'd1;
                  hj_state <= HJ_STATE_FETCH;
                end
              end

              HJ_OP_EPOCH_FROM_PHASE: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip != 8'd0
                    || instruction_arg1 != 32'd0
                    || (program_counter + 32'd1
                        >= active_instruction_count)) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  event_epoch <= event_phase_id;
                  program_counter <= program_counter + 32'd1;
                  hj_state <= HJ_STATE_FETCH;
                end
              end

              HJ_OP_REJECT: begin
                if (instruction_reserved
                    || instruction_arg0 != 8'd0
                    || instruction_skip != 8'd0
                    || instruction_arg1 == 32'd0
                    || instruction_arg1 > 32'd65535) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  last_reject_code <= instruction_arg1[15:0];
                  hj_state <= HJ_STATE_REJECT;
                end
              end

              default: begin
                policy_error <= SLUG_JIT_ERR_UNSUPPORTED;
                policy_ready <= 1'b0;
                metadata_drop_count <= metadata_drop_count + 64'd1;
                hj_state <= HJ_STATE_ERROR;
              end
            endcase
          end
        end

        HJ_STATE_MATCH: begin
          if ((!match_result
               && branch_target >= active_instruction_count)
              || (match_result
                  && (program_counter + 32'd1
                      >= active_instruction_count))) begin
            policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
            policy_ready <= 1'b0;
            metadata_drop_count <= metadata_drop_count + 64'd1;
            hj_state <= HJ_STATE_ERROR;
          end else begin
            if (match_result)
              program_counter <= program_counter + 32'd1;
            else
              program_counter <= branch_target;
            hj_state <= HJ_STATE_FETCH;
          end
        end

        HJ_STATE_CAPTURE: begin
          case (capture_mode)
            HJ_CAPTURE_VALIDATION: begin
              if (active_metadata_budget < 32'd8) begin
                policy_error <= SLUG_JIT_ERR_BUDGET_EXCEEDED;
                policy_ready <= 1'b0;
                metadata_drop_count <= metadata_drop_count + 64'd1;
                hj_state <= HJ_STATE_ERROR;
              end else if (program_counter + 32'd1
                           >= active_instruction_count) begin
                policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                policy_ready <= 1'b0;
                metadata_drop_count <= metadata_drop_count + 64'd1;
                hj_state <= HJ_STATE_ERROR;
              end else begin
                capture_data[63:0] <=
                    hash_payload(event_payload, event_payload_len);
                captured_bytes <= 6'd8;
                capture_ready <= 1'b1;
                program_counter <= program_counter + 32'd1;
                hj_state <= HJ_STATE_FETCH;
              end
            end

            HJ_CAPTURE_FULL: begin
              if ({26'd0, event_payload_len}
                  > active_metadata_budget) begin
                policy_error <= SLUG_JIT_ERR_BUDGET_EXCEEDED;
                policy_ready <= 1'b0;
                metadata_drop_count <= metadata_drop_count + 64'd1;
                hj_state <= HJ_STATE_ERROR;
              end else if (program_counter + 32'd1
                           >= active_instruction_count) begin
                policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                policy_ready <= 1'b0;
                metadata_drop_count <= metadata_drop_count + 64'd1;
                hj_state <= HJ_STATE_ERROR;
              end else begin
                capture_data <= mask_payload(event_payload, event_payload_len);
                captured_bytes <= event_payload_len;
                capture_ready <= 1'b1;
                program_counter <= program_counter + 32'd1;
                hj_state <= HJ_STATE_FETCH;
              end
            end

            HJ_CAPTURE_DELTA: begin
              if (event_payload_len == 6'd0) begin
                if (program_counter + 32'd1
                    >= active_instruction_count) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  capture_ready <= 1'b1;
                  program_counter <= program_counter + 32'd1;
                  hj_state <= HJ_STATE_FETCH;
                end
              end else if (event_payload[
                               delta_scan_index * 8 +: 8] != 8'd0) begin
                if (delta_pair_count >= 6'd16
                    || ({26'd0, captured_bytes} + 32'd2)
                       > active_metadata_budget) begin
                  policy_error <= SLUG_JIT_ERR_BUDGET_EXCEEDED;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  capture_data[delta_pair_count * 16 +: 16] <= {
                    event_payload[delta_scan_index * 8 +: 8],
                    {2'd0, delta_scan_index}
                  };
                  delta_pair_count <= delta_pair_count + 6'd1;
                  captured_bytes <= captured_bytes + 6'd2;
                  if (delta_scan_index + 6'd1
                      == event_payload_len) begin
                    if (program_counter + 32'd1
                        >= active_instruction_count) begin
                      policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                      policy_ready <= 1'b0;
                      metadata_drop_count <= metadata_drop_count + 64'd1;
                      hj_state <= HJ_STATE_ERROR;
                    end else begin
                      capture_ready <= 1'b1;
                      program_counter <= program_counter + 32'd1;
                      hj_state <= HJ_STATE_FETCH;
                    end
                  end else begin
                    delta_scan_index <= delta_scan_index + 6'd1;
                  end
                end
              end else if (delta_scan_index + 6'd1
                           == event_payload_len) begin
                if (program_counter + 32'd1
                    >= active_instruction_count) begin
                  policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
                  policy_ready <= 1'b0;
                  metadata_drop_count <= metadata_drop_count + 64'd1;
                  hj_state <= HJ_STATE_ERROR;
                end else begin
                  capture_ready <= 1'b1;
                  program_counter <= program_counter + 32'd1;
                  hj_state <= HJ_STATE_FETCH;
                end
              end else begin
                delta_scan_index <= delta_scan_index + 6'd1;
              end
            end

            default: begin
              policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
              policy_ready <= 1'b0;
              metadata_drop_count <= metadata_drop_count + 64'd1;
              hj_state <= HJ_STATE_ERROR;
            end
          endcase
        end

        HJ_STATE_EMIT_WAIT: begin
          if (record_valid
              && ((record_data != pending_record_data)
                  || (record_length != pending_record_length))) begin
            policy_error <= SLUG_JIT_ERR_DROP;
            policy_ready <= 1'b0;
            metadata_drop_count <= metadata_drop_count + 64'd1;
            hj_state <= HJ_STATE_ERROR;
          end else if (!record_valid) begin
            record_valid <= 1'b1;
            record_data <= pending_record_data;
            record_length <= pending_record_length;
          end else if (record_ready) begin
            record_valid <= 1'b0;
            sequence_id <= sequence_id + 64'd1;
            event_count <= event_count + 64'd1;
            record_count <= record_count + 64'd1;
            metadata_bytes <= metadata_bytes
                + {58'd0, captured_bytes};
            instruction_count <= instruction_count
                + pending_instruction_steps;
            epoch <= event_epoch;
            hj_state <= HJ_STATE_DONE;
          end
        end

        HJ_STATE_REJECT: begin
          event_count <= event_count + 64'd1;
          reject_count <= reject_count + 64'd1;
          instruction_count <= instruction_count
              + {58'd0, execution_steps};
          epoch <= event_epoch;
          hj_state <= HJ_STATE_DONE;
        end

        HJ_STATE_DONE: begin
          hj_state <= HJ_STATE_IDLE;
        end

        HJ_STATE_ERROR: begin
          hj_state <= HJ_STATE_ERROR;
        end

        default: begin
          policy_error <= SLUG_JIT_ERR_BACKEND;
          policy_ready <= 1'b0;
          metadata_drop_count <= metadata_drop_count + 64'd1;
          hj_state <= HJ_STATE_ERROR;
        end
      endcase

      if (policy_load_abort) begin
        load_in_progress <= 1'b0;
        load_failed <= 1'b0;
        load_seen <= 40'd0;
        load_word_count <= 7'd0;
      end else begin
        if (policy_load_begin) begin
          if (load_in_progress
              || ((hj_state != HJ_STATE_IDLE)
                  && (hj_state != HJ_STATE_ERROR))
              || record_valid) begin
            policy_error <= SLUG_JIT_ERR_BACKEND;
            if (load_in_progress)
              load_failed <= 1'b1;
          end else begin
            load_in_progress <= 1'b1;
            load_failed <= 1'b0;
            load_bank <= ~active_bank;
            load_seen <= 40'd0;
            load_word_count <= 7'd0;
            load_magic <= 32'd0;
            load_abi_version <= 32'd0;
            load_event_version <= 32'd0;
            load_packet_version <= 32'd0;
            load_instruction_count <= 32'd0;
            load_range_count <= 32'd0;
            load_metadata_budget <= 32'd0;
            load_image_bytes <= 32'd0;
            load_digest_header <= 256'd0;
            policy_error <= 32'd0;
            if (active_bank == 1'b0) begin
              for (i = 0; i < 32; i = i + 1)
                policy_words_bank1[i] <= 128'd0;
              for (i = 0; i < 4; i = i + 1)
                range_words_bank1[i] <= 128'd0;
            end else begin
              for (i = 0; i < 32; i = i + 1)
                policy_words_bank0[i] <= 128'd0;
              for (i = 0; i < 4; i = i + 1)
                range_words_bank0[i] <= 128'd0;
            end
          end
        end

        if (policy_load_valid) begin
          if (!load_in_progress) begin
            policy_error <= SLUG_JIT_ERR_BACKEND;
          end else if (policy_load_index >= 16'd40) begin
            policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
            load_failed <= 1'b1;
          end else if (load_seen[policy_load_index[5:0]]) begin
            policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
            load_failed <= 1'b1;
          end else begin
            load_seen[policy_load_index[5:0]] <= 1'b1;
            load_word_count <= load_word_count + 7'd1;
            case (policy_load_index)
              16'd0: begin
                load_magic          <= policy_load_word[31:0];
                load_abi_version    <= policy_load_word[63:32];
                load_event_version  <= policy_load_word[95:64];
                load_packet_version <= policy_load_word[127:96];
              end
              16'd1: begin
                load_instruction_count <= policy_load_word[31:0];
                load_range_count       <= policy_load_word[63:32];
                load_metadata_budget   <= policy_load_word[95:64];
                load_image_bytes       <= policy_load_word[127:96];
              end
              16'd2: load_digest_header[127:0] <= policy_load_word;
              16'd3: load_digest_header[255:128] <= policy_load_word;
              default: begin
                if (policy_load_index < 16'd36) begin
                  if (load_bank == 1'b0)
                    policy_words_bank0[policy_slot] <= policy_load_word;
                  else
                    policy_words_bank1[policy_slot] <= policy_load_word;
                end else begin
                  if (load_bank == 1'b0)
                    range_words_bank0[range_slot] <= policy_load_word;
                  else
                    range_words_bank1[range_slot] <= policy_load_word;
                end
              end
            endcase
          end
        end

        if (policy_load_commit) begin
          if (!load_in_progress) begin
            policy_error <= SLUG_JIT_ERR_BACKEND;
          end else if (load_failed) begin
            load_in_progress <= 1'b0;
          end else if (load_word_count != POLICY_IMAGE_WORDS
                       || load_seen != 40'hffffffffff) begin
            policy_error <= SLUG_JIT_ERR_STRUCT_SIZE;
            load_in_progress <= 1'b0;
          end else if (load_magic != POLICY_MAGIC
                       || load_image_bytes != POLICY_IMAGE_BYTES) begin
            policy_error <= SLUG_JIT_ERR_STRUCT_SIZE;
            load_in_progress <= 1'b0;
          end else if (load_abi_version != POLICY_ABI_VERSION
                       || load_event_version != EVENT_ABI_VERSION
                       || load_packet_version != PACKET_ABI_VERSION) begin
            policy_error <= SLUG_JIT_ERR_ABI_VERSION;
            load_in_progress <= 1'b0;
          end else if (load_instruction_count > 32
                       || load_instruction_count
                          != policy_load_instruction_count) begin
            policy_error <= SLUG_JIT_ERR_TOO_MANY_INSTRUCTIONS;
            load_in_progress <= 1'b0;
          end else if (load_range_count > 4
                       || load_range_count != policy_load_range_count) begin
            policy_error <= SLUG_JIT_ERR_TOO_MANY_RANGES;
            load_in_progress <= 1'b0;
          end else if (load_metadata_budget > 32'd256) begin
            policy_error <= SLUG_JIT_ERR_BUDGET_EXCEEDED;
            load_in_progress <= 1'b0;
          end else if (load_digest_header != policy_load_digest) begin
            policy_error <= SLUG_JIT_ERR_DIGEST_MISMATCH;
            load_in_progress <= 1'b0;
          end else begin
            active_bank <= load_bank;
            active_instruction_count <= load_instruction_count;
            active_range_count <= load_range_count;
            active_metadata_budget <= load_metadata_budget;
            policy_digest <= load_digest_header;
            policy_ready <= 1'b1;
            policy_error <= 32'd0;
            load_in_progress <= 1'b0;
            load_failed <= 1'b0;
            hj_state <= HJ_STATE_IDLE;
            record_valid <= 1'b0;
            record_length <= 16'd0;
            record_data <= 1024'd0;
            event_count <= 64'd0;
            record_count <= 64'd0;
            metadata_bytes <= 64'd0;
            reject_count <= 64'd0;
            instruction_count <= 64'd0;
            epoch <= 64'd0;
            app_flit_bytes <= 64'd0;
            stall_cycles <= 64'd0;
            metadata_drop_count <= 64'd0;
            last_reject_code <= 16'd0;
            sequence_id <= 64'd0;
          end
        end
      end
    end
  end

  function automatic supported_event_class(input [3:0] class_value);
    begin
      supported_event_class =
          (class_value == 4'd1)
        || (class_value == 4'd2)
        || (class_value == 4'd3)
        || (class_value == 4'd4);
    end
  endfunction

  function automatic payload_tail_nonzero(
    input [255:0] payload,
    input [5:0] length
  );
    integer byte_index;
    begin
      payload_tail_nonzero = 1'b0;
      for (byte_index = 0; byte_index < 32; byte_index = byte_index + 1)
        if ((byte_index >= length)
            && (payload[byte_index * 8 +: 8] != 8'd0))
          payload_tail_nonzero = 1'b1;
    end
  endfunction

  function automatic [63:0] hash_payload(
    input [255:0] payload,
    input [5:0] length
  );
    integer byte_index;
    reg [63:0] hash;
    begin
      hash = 64'hcbf29ce484222325;
      for (byte_index = 0; byte_index < 32; byte_index = byte_index + 1) begin
        if (byte_index < length) begin
          hash = hash ^ {{56'd0, payload[byte_index * 8 +: 8]}};
          hash = hash * 64'h00000100000001b3;
        end
      end
      hash_payload = hash;
    end
  endfunction

  function automatic [255:0] mask_payload(
    input [255:0] payload,
    input [5:0] length
  );
    integer byte_index;
    reg [255:0] masked;
    begin
      masked = 256'd0;
      for (byte_index = 0; byte_index < 32; byte_index = byte_index + 1)
        if (byte_index < length)
          masked[byte_index * 8 +: 8] =
              payload[byte_index * 8 +: 8];
      mask_payload = masked;
    end
  endfunction

  function automatic [1023:0] make_record(
    input [63:0] record_sequence,
    input [63:0] record_event_id,
    input [255:0] digest,
    input [63:0] record_epoch,
    input direction,
    input [3:0] record_class,
    input [3:0] opcode,
    input [63:0] address,
    input [63:0] tag,
    input [31:0] status,
    input [1:0] mode,
    input [5:0] payload_length,
    input [5:0] capture_length,
    input [5:0] pair_count,
    input [255:0] payload_capture
  );
    reg [1023:0] record_bits;
    begin
      record_bits = 1024'd0;
      record_bits[7:0] = 8'd1;
      record_bits[15:8] = 8'd1;
      record_bits[23:16] = 8'd1;
      record_bits[31:24] = 8'd0;
      record_bits[95:32] = record_sequence;
      record_bits[159:96] = record_event_id;
      record_bits[415:160] = digest;
      record_bits[479:416] = record_epoch;
      record_bits[487:480] = {{7'd0, direction}};
      record_bits[495:488] = {{4'd0, record_class}};
      record_bits[511:496] = {{12'd0, opcode}};
      record_bits[575:512] = address;
      record_bits[639:576] = tag;
      record_bits[671:640] = status;
      record_bits[679:672] = {{6'd0, mode}};
      record_bits[687:680] = {{2'd0, payload_length}};
      record_bits[695:688] = {{2'd0, capture_length}};
      record_bits[703:696] = {{2'd0, pair_count}};
      record_bits[1023:768] = payload_capture;
      make_record = record_bits;
    end
  endfunction

endmodule
