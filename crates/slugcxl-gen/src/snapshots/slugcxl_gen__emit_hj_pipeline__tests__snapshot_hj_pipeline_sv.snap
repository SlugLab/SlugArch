    end else begin
      if (record_valid && !record_ready)
        stall_cycles <= stall_cycles + 64'd1;

      case (hj_state)
        HJ_STATE_IDLE: begin
          if (any_fire) begin
            app_flit_bytes <= app_flit_bytes + 64'd64;
            if (chosen_payload_len > 6'd32
                || chosen_reserved
                || payload_tail_nonzero(chosen_payload, chosen_payload_len)
                || !supported_event_class(chosen_class)) begin
              policy_error <= SLUG_JIT_ERR_UNSUPPORTED;
              policy_ready <= 1'b0;
              metadata_drop_count <= metadata_drop_count + 64'd1;
              hj_state <= HJ_STATE_ERROR;
            end else begin
              event_id <= chosen_event_id;
              event_direction <= chosen_direction;
              event_class <= chosen_class;
              event_opcode <= chosen_opcode;
              event_address <= chosen_address;
              event_tag <= chosen_tag;
              event_phase_id <= chosen_phase_id;
              event_status <= chosen_status;
              event_payload_len <= chosen_payload_len;
              event_payload <= chosen_payload;
              event_epoch <= epoch;
              program_counter <= 32'd0;
              execution_steps <= 6'd0;
              capture_mode <= HJ_CAPTURE_VALIDATION;
              capture_ready <= 1'b0;
              captured_bytes <= 6'd0;
              delta_pair_count <= 6'd0;
              delta_scan_index <= 6'd0;
              capture_data <= 256'd0;
              emit_requested <= 1'b0;
              last_reject_code <= 16'd0;
