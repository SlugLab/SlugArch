        HJ_STATE_FETCH: begin
          if (program_counter >= active_instruction_count) begin
            policy_error <= SLUG_JIT_ERR_INVALID_CONTROL_FLOW;
            policy_ready <= 1'b0;
            metadata_drop_count <= metadata_drop_count + 64'd1;
            hj_state <= HJ_STATE_ERROR;
