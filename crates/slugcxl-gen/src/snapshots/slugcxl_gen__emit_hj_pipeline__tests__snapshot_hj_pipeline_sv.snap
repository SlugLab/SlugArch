  reg [5:0]   delta_pair_count;
  reg [5:0]   delta_scan_index;
  reg [255:0] capture_data;
  reg         emit_requested;

  reg [1023:0] pending_record_data;
  reg [15:0]   pending_record_length;
  reg [63:0]   pending_instruction_steps;
  reg [63:0]   sequence_id;
  integer i;

  wire [4:0] policy_slot = policy_load_index[4:0] - 5'd4;
  wire [1:0] range_slot = policy_load_index[1:0];
  assign policy_load_ready =
      load_in_progress
    && (policy_load_index < 16'd40)
    && !load_seen[policy_load_index[5:0]];

  wire engine_idle =
      (hj_state == HJ_STATE_IDLE)
    && policy_ready
    && (policy_error == 32'd0)
    && !load_in_progress
    && !record_valid;

  // Device responses win arbitration so a host that holds valid while the
  // single-outstanding endpoint is responding cannot create a circular stall.
  assign ep_flit_valid  = h2d_flit_valid && engine_idle
      && !ep_resp_valid;
  assign h2d_flit_ready = ep_flit_ready && engine_idle
      && !ep_resp_valid;
  assign ep_flit_data   = h2d_flit_data;
  assign d2h_flit_valid = ep_resp_valid && engine_idle;
  assign ep_resp_ready  = d2h_flit_ready && engine_idle;
  assign d2h_flit_data  = ep_resp_data;

  wire h2d_fire = ep_flit_valid && ep_flit_ready;
  wire d2h_fire = d2h_flit_valid && d2h_flit_ready;
  wire any_fire = h2d_fire || d2h_fire;
  wire [FLIT_BITS-1:0] chosen_flit =
      h2d_fire ? h2d_flit_data : ep_resp_data;

  wire [3:0]  chosen_class       = chosen_flit[7:4];
  wire [3:0]  chosen_opcode      = chosen_flit[3:0];
  wire [15:0] chosen_tag         = chosen_flit[23:8];
  wire [63:0] chosen_address     = chosen_flit[87:24];
  wire [255:0] chosen_payload    = chosen_flit[343:88];
  wire [63:0] chosen_event_id    = chosen_flit[407:344];
  wire [63:0] chosen_phase_id    = chosen_flit[471:408];
  wire [31:0] chosen_status      = chosen_flit[503:472];
  wire        chosen_reserved    = chosen_flit[510];
  wire        chosen_direction   = chosen_flit[511];
  wire [5:0]  chosen_payload_len = chosen_flit[509:504];

  wire [7:0] instruction_opcode = current_instruction[7:0];
  wire [7:0] instruction_arg0 = current_instruction[15:8];
  wire [7:0] instruction_skip = current_instruction[23:16];
  wire [31:0] instruction_arg1 = current_instruction[63:32];
  wire [7:0] instruction_range_index = current_instruction[15:8];
  wire [31:0] instruction_stride = current_instruction[63:32];
