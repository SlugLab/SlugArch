  localparam [3:0] HJ_STATE_EMIT_WAIT = 4'd5;
  localparam [3:0] HJ_STATE_REJECT = 4'd6;
  localparam [3:0] HJ_STATE_DONE = 4'd7;
  localparam [3:0] HJ_STATE_ERROR = 4'd8;

  reg [127:0] policy_words_bank0 [0:31];
  reg [127:0] policy_words_bank1 [0:31];
