        end

        HJ_STATE_DECODE: begin
          if ((execution_steps == 6'd31)
              && (instruction_opcode != HJ_OP_HALT)
              && (instruction_opcode != HJ_OP_REJECT)) begin
            policy_error <= SLUG_JIT_ERR_TIMEOUT;
            policy_ready <= 1'b0;
            metadata_drop_count <= metadata_drop_count + 64'd1;
            hj_state <= HJ_STATE_ERROR;
          end else begin
            execution_steps <= execution_steps + 6'd1;
            case (instruction_opcode)
              HJ_OP_HALT: begin
