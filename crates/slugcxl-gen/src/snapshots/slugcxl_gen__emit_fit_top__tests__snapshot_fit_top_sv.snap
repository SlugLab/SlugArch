      observed_drop_count <= hj_metadata_drop_count;
      observed_policy_error <= policy_error;
      observed_policy_digest <= policy_digest;
      observed_last_reject_code <= hj_last_reject_code;
      if (record_valid)
        observed_record_last <= record_data;

      if (policy_ready && !done_q) begin
        flit_in_valid <= 1'b1;
        flit_in_data <= stimulus_event(seq_idx);
        if (flit_in_ready) begin
          if (seq_idx == 4'd7) begin
            done_q <= 1'b1;
            flit_in_valid <= 1'b0;
          end else begin
            seq_idx <= seq_idx + 4'd1;
          end
        end
      end else begin
        flit_in_valid <= 1'b0;
      end
    end
  end

  assign status_led =
      done_q
    ^ policy_ready
    ^ observed_event_count[0]
    ^ observed_record_count[0]
    ^ observed_metadata_bytes[0]
    ^ observed_reject_count[0]
    ^ observed_instruction_count[0]
    ^ observed_epoch[0]
    ^ observed_app_flit_bytes[0]
    ^ observed_stall_cycles[0]
    ^ observed_drop_count[0]
    ^ observed_policy_error[0]
    ^ observed_policy_digest[0]
    ^ observed_record_last[0]
    ^ observed_last_reject_code[0]
    ^ record_length[0]
    ^ flit_out_valid
    ^ flit_out_data[0];

  function automatic [FLIT_BITS-1:0] stimulus_event(input [3:0] index);
    reg [FLIT_BITS-1:0] event_bits;
    begin
      event_bits = '0;
      event_bits[7:0] = 8'h20; // local CXL.mem-write class/opcode
      event_bits[23:8] = {12'd0, index};
      event_bits[87:24] = 64'd83886080;
      event_bits[151:88] = {60'd0, index};
      event_bits[407:344] = {60'd0, index} + 64'd1;
      event_bits[471:408] = 64'd3;
      event_bits[503:472] = 32'd0;
      event_bits[511:504] = 8'd8;
      stimulus_event = event_bits;
    end
  endfunction

